{
  "name": "z-library-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build && node scripts/generate-assets.mjs",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "precheck": "npm run build",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "pretest": "npm run build",
    "test": "node --test",
    "postinstall": "npm --prefix frontend install --no-audit --no-fund"
  },
  "devDependencies": {
    "wrangler": "^4.28.1"
  }
}
